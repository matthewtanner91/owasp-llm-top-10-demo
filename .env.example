# LLM Backend Configuration
LLM_API_URL=http://localhost:11434
LLM_MODEL=tinyllama

# Server Configuration
PORT=3000
NODE_ENV=development

# VULNERABLE: API Keys stored in plain text
ADMIN_API_KEY=super-secret-admin-key-12345
DATABASE_URL=mongodb://admin:password123@localhost:27017/aiapp

# VULNERABLE: Sensitive configuration exposed
SYSTEM_PROMPT=You are a helpful AI assistant.
MAX_TOKENS=2000
TEMPERATURE=0.7
